{
  "name": "unimancer",
  "version": "0.1.0",
  "description": "Companion to the Unity CLI — an MCP server for Android device/emulator tooling and the HTML→Unity art bridge, plus UGUI/sprite authoring commands for com.unity.pipeline.",
  "type": "module",
  "bin": {
    "unimancer": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "unity",
    "android",
    "game-development",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.61.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
